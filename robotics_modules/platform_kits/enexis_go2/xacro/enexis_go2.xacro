<?xml version="1.0"?>

<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find sim_lidar)/xacro/lidar.xacro"/>
    <xacro:include filename="$(find septentrio)/xacro/gnss.xacro"/>
    <xacro:include filename="$(find go2_description)/xacro/unitree_go2.xacro"/>

    <!-- Joint attaching lidar to trunk (mounted on top). The 18.5 deg pitch was
         measured on the robot (Livox IMU vs Go2 IMU); the drawing value is 17 deg. -->
    <joint name="lidar_joint" type="fixed">
        <parent link="trunk"/>
        <child link="lidar_link"/>
        <origin xyz="0.32 0.0 ${trunk_height/2.0 + lidar_height/2.0 + 0.051}" rpy="0 ${18.5*pi/180} 0"/>
    </joint>

    <joint name="gps_joint" type="fixed">
        <parent link="trunk"/>
        <child link="gps_link"/>
        <origin xyz="0.325 0 0" rpy="0 0 0"/>
    </joint>
    <joint name="aux_gps_joint" type="fixed">
        <parent link="trunk"/>
        <child link="aux_gps_link"/>
        <origin xyz="-0.11 0 0" rpy="0 0 0"/>
    </joint>

</robot>
