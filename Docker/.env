# Set the RMW implementation to Cyclone DDS for communication with hardware components that require it,
# and specify the Cyclone DDS configuration file to use.:
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=/workspace/cyclonedds/cyclonedds_jetson.xml

XAUTHORITY=/tmp/.Xauthority

# Using NVIDIA GPU:
# Note you have to set runtime: nvidia in the docker-compose file to use these settings.
DISPLAY
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# Colored terminal:
RCUTILS_COLORIZED_OUTPUT=1
